# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=organ_donation_db

# Redis Cache Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_EXPIRE_TIME=3600

# Authentication (JWT)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Frontend URL)
CLIENT_URL=http://localhost:3000

# Email Configuration Options:
# Option 1: Brevo HTTP REST API (Recommended for Render free tier - sends to any email address)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=your-signup-email@gmail.com

# Option 2: Resend HTTP API (Port 443)
RESEND_API_KEY=re_your_api_key_here

# Option 3: Standard SMTP (Local Development)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM="Organova" <your-email@gmail.com>
